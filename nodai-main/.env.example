# Supabase (required)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Solana devnet — use a dedicated RPC on Vercel (public endpoint rate-limits serverless)
SOLANA_RPC_URL=https://api.devnet.solana.com
PUBLIC_SOLANA_CLUSTER=devnet

# NOD token — run `npm run nod:setup` to generate these
NOD_MINT_ADDRESS=
TREASURY_SECRET_KEY=

# vLLM inference server (RunPod or local GPU)
VLLM_API_URL=
VLLM_API_KEY=

# Optional public links (shown in nav/footer)
PUBLIC_GITHUB_URL=https://github.com/ZeitbyteLabs/nodai-main
# PUBLIC_DISCORD_URL=
